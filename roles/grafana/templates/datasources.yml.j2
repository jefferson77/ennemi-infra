# Managed by the ennemi infrastructure (roles/grafana).
apiVersion: 1

datasources:
  - name: Prometheus
    type: prometheus
    # The uid the hand install gave it, which the dashboards reference.
    uid: PBFA97CFB590B2093
    access: proxy
    url: {{ grafana_prometheus_url }}
    isDefault: true
    editable: false
    jsonData:
      timeInterval: "15s"
      httpMethod: POST
  - name: Loki
    type: loki
    uid: loki
    access: proxy
    url: {{ grafana_loki_url }}
    editable: false
    jsonData:
      maxLines: 2000
