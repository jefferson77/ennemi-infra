# Managed by the ennemi infrastructure (roles/ennemi_webapp). Holds the database
# password and ennemi-web's show token: root-only, read by systemd before it
# starts {{ ennemi_webapp_service }}.
{% if postgres_app_password | default('') %}
NUXT_DATABASE_URL=postgresql://{{ ennemi_webapp_database_user }}:{{ postgres_app_password | urlencode | replace('/', '%2F') }}@{{ ennemi_webapp_database_host }}:{{ ennemi_webapp_database_port }}/{{ ennemi_webapp_database_name }}
{% endif %}
{% if ennemi_web_show_token | default('') %}
NUXT_WEBSITE_LIVE_URL={{ ennemi_webapp_website_live_url }}
NUXT_WEBSITE_SHOW_TOKEN={{ ennemi_web_show_token }}
{% endif %}
