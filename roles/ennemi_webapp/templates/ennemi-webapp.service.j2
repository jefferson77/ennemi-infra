# Managed by the ennemi infrastructure (roles/ennemi_webapp). The build and the
# show content in {{ ennemi_webapp_dir }} are pushed by the webapp project's
# `make deploy`, which restarts this unit afterwards.
[Unit]
Description=Ennemi Web Application
After=network.target dragonfly.service {{ ennemi_webapp_database_unit }}
Wants={{ ennemi_webapp_database_unit }}
# Enabled before the first deploy, which is harmless: until the build is
# there, starting the unit is a no-op rather than a failure.
ConditionPathExists={{ ennemi_webapp_entry }}

[Service]
Type=simple
User={{ ennemi_webapp_user }}
Group={{ ennemi_webapp_group }}
WorkingDirectory={{ ennemi_webapp_dir }}
ExecStart={{ ennemi_webapp_node }} --enable-source-maps {{ ennemi_webapp_entry }}
# NUXT_DATABASE_URL. Read by systemd, as root, so the file can stay root-only.
# Optional ("-"): without it the app still serves the show, minus the
# spectacle instances, rather than refusing to start.
EnvironmentFile=-{{ ennemi_webapp_env_file }}
Environment=NODE_ENV=production
Environment=PORT={{ ennemi_webapp_port }}
{% if ennemi_webapp_network_ip %}
Environment=NUXT_PUBLIC_NETWORK_IP={{ ennemi_webapp_network_ip }}
{% endif %}
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ ennemi_webapp_service }}

# Hardening. The whole filesystem is read-only to the service except the show
# content it edits at runtime; the build itself stays read-only. No
# MemoryDenyWriteExecute: V8's JIT needs writable executable memory.
ProtectSystem=strict
ReadWritePaths={% for dir in ennemi_webapp_writable_dirs %}{{ ennemi_webapp_dir }}/{{ dir }}{{ ' ' if not loop.last }}{% endfor %}

ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
