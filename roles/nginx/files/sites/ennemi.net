# HTTP Server Block - Redirect to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name www.ennemi.net ennemi.net;

    # Redirect all HTTP traffic to HTTPS
    location / {
        return 301 https://www.ennemi.net$request_uri;
    }
}

# HTTPS Server Block - Main Application
server {
    listen 443 ssl;
    http2 on;
    listen [::]:443 ssl;
    server_name www.ennemi.net ennemi.net;

    # SSL Certificates
    ssl_certificate /etc/letsencrypt/live/www.ennemi.net/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.ennemi.net/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/www.ennemi.net/chain.pem;

    # SSL Configuration - Mozilla Intermediate Profile
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305';
    ssl_prefer_server_ciphers off;

    # SSL Session Configuration
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;

    # OCSP Stapling
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 8.8.8.8 8.8.4.4 valid=300s;
    resolver_timeout 5s;

    # Security Headers
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # ========================================
    # COMPRESSION OPTIMIZATION
    # ========================================

    # Enable gzip compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_buffers 16 8k;
    gzip_http_version 1.1;
    gzip_min_length 256;

    # Compress all relevant content types (excluding WebSocket)
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/x-javascript
        application/xml
        application/xml+rss
        application/xhtml+xml
        image/svg+xml
        image/x-icon
        font/opentype
        font/truetype
        font/eot
        font/otf;

    # ========================================
    # BROTLI COMPRESSION
    # ========================================

    brotli on;
    brotli_comp_level 6;
    brotli_static on;
    brotli_min_length 256;

    brotli_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/json
        application/javascript
        application/x-javascript
        application/xml
        application/xml+rss
        application/xhtml+xml
        image/svg+xml
        image/x-icon
        font/opentype
        font/truetype
        font/eot
        font/otf;

    # ========================================
    # MONITORING - GRAFANA SUBPATH
    # ========================================
    location /grafana/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;

        # WebSocket support for live updates
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Standard proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Buffering settings
        proxy_buffering off;
    }

    # ========================================
    # ADGUARD HOME - DNS ADMIN PANEL
    # ========================================
    location /adguard/ {
        proxy_pass http://127.0.0.1:2000/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering off;
    }

    # ========================================
    # MONITORING - PROMETHEUS SUBPATH
    # ========================================
    location /prometheus/ {
        proxy_pass http://127.0.0.1:9090;
        proxy_http_version 1.1;

        # Standard proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Buffering settings
        proxy_buffering off;
    }

    # ========================================
    # WEBSOCKET ENDPOINT - NO COMPRESSION!
    # ========================================
    # WebSocket frames MUST NOT be compressed by nginx
    # Binary msgpack data would be corrupted
    location /api/websocket {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;

        # WebSocket upgrade headers
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Standard proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket-specific settings
        proxy_buffering off;
        proxy_connect_timeout 7d;
        proxy_send_timeout 7d;
        proxy_read_timeout 7d;

        # CRITICAL: Disable compression for WebSocket
        gzip off;
        brotli off;

        # Do NOT set Accept-Encoding header - let WebSocket handle it
    }



    # ========================================
    # STATIC ASSETS - Direct serving with pre-compression
    # Phase 1 + Phase 3 Optimization
    # ========================================
    # Serve hashed static files directly from disk (not proxied)
    # nginx will automatically serve .br or .gz files if available
    location /_nuxt/ {
        alias /home/ennemi/webapp/.output/public/_nuxt/;

        # Cache for 1 year (hashed filenames = immutable)
        add_header Cache-Control "public, max-age=31536000, immutable" always;

        # Enable serving pre-compressed files
        gzip_static on;
        brotli_static on;

        # Disable dynamic compression (we have pre-compressed files)
        gzip off;
        brotli off;

        # Security headers
        add_header X-Content-Type-Options "nosniff" always;

        # Try the requested file
        try_files $uri =404;
    }
    # ========================================
    # UPLOADED ASSETS - Served from public/
    # ========================================
    # These are uploaded via Asset Manager, not built by Nuxt
    location /images/ {
        alias /home/ennemi/webapp/public/images/;
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location /audio/ {
        alias /home/ennemi/webapp/public/audio/;
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # ========================================
    # ========================================
    # LIVE VIDEO STREAM - MediaMTX WHEP Proxy
    # ========================================
    location /live/ {
        proxy_pass http://127.0.0.1:8889/;
        proxy_http_version 1.1;

        # Standard proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # CORS headers for WHEP
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type" always;

        # Handle preflight requests
        if ($request_method = 'OPTIONS') {
            add_header Access-Control-Allow-Origin "*";
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS";
            add_header Access-Control-Allow-Headers "Content-Type";
            add_header Content-Length 0;
            add_header Content-Type text/plain;
            return 204;
        }

        # Disable compression for video
        gzip off;
        brotli off;

        # Buffering off for real-time
        proxy_buffering off;
    }

    # DEFAULT LOCATION - WITH COMPRESSION
    # ========================================
    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;

        # WebSocket upgrade headers (for compatibility)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';

        # Standard proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Disable cache for dynamic content
        proxy_cache_bypass $http_upgrade;

        # Enable compression for regular HTTP requests
        # NOTE: Removed problematic "proxy_set_header Accept-Encoding gzip"
        # Let nginx handle compression based on gzip/brotli directives above
    }
}
