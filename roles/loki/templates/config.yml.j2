# Managed by the ennemi infrastructure (roles/loki). Single-binary Loki on the
# local filesystem, for this host's Grafana only.
auth_enabled: false

server:
  http_listen_address: {{ loki_listen_address }}
  http_listen_port: {{ loki_http_port }}
  grpc_listen_address: {{ loki_listen_address }}
  grpc_listen_port: {{ loki_grpc_port }}
  log_level: {{ loki_log_level }}

common:
  instance_addr: {{ loki_listen_address }}
  path_prefix: {{ loki_data_dir }}
  storage:
    filesystem:
      chunks_directory: {{ loki_data_dir }}/chunks
      rules_directory: {{ loki_data_dir }}/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

schema_config:
  configs:
    - from: "{{ loki_schema_from }}"
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

compactor:
  working_directory: {{ loki_data_dir }}/compactor
  retention_enabled: true
  delete_request_store: filesystem

limits_config:
  retention_period: {{ loki_retention_period }}
  ingestion_rate_mb: {{ loki_ingestion_rate_mb }}
  ingestion_burst_size_mb: {{ loki_ingestion_burst_size_mb }}
  # The UK Ultra keeps its log in RAM and may replay old lines when it comes
  # back; a line older than the window is still worth keeping.
  reject_old_samples: false
  max_query_series: 5000
  allow_structured_metadata: true

analytics:
  reporting_enabled: false
