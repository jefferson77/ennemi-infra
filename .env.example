# Credentials for the ennemi infrastructure.
#
#   cp .env.example .env      then fill in the real values
#
# .env is git-ignored and is the only place a secret belongs; this file is the
# committed template, so every value in it must stay a placeholder.
#
# Format: KEY=value, one per line, read by inventory/group_vars/all.yml.
# Do NOT quote values — quotes are read as part of the value. # starts a
# comment only at the beginning of a line.

# Password of the "ennemi" PostgreSQL role, which owns the "ennemi" database
# (roles/postgres). This is what the application authenticates with, from any
# host allowed by postgres_hba_entries.
POSTGRES_APP_PASSWORD=change-me
